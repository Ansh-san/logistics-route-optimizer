# ============================================================
# Root .gitignore — Route-Visualiser monorepo
# ============================================================

# ----- Dependencies (both workspaces) -----
node_modules/
logistics-visualizer/node_modules/
server/node_modules/

# ----- Build output -----
dist/
dist-ssr/
logistics-visualizer/dist/
logistics-visualizer/dist-ssr/

# ----- Environment / secrets -----
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Editor & OS -----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ----- Misc -----
*.local
coverage/
.cache/